{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:untie:schema:model:1",
  "title": "UntieModel",
  "description": "Untie の業務モデル。要素 (elements) と型付きの関係 (relations) と、要素をどこに置くかだけを持つボード (boards) から成る。要素・関係・ボードは安定した id を持ち、参照はすべて id で行う。参照整合性はスキーマでは表現できないので validateModel() で別途検査する。",
  "type": "object",
  "required": ["version", "meta", "elements", "relations", "boards"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "任意。エディタ補完用のスキーマ参照。",
      "type": "string"
    },
    "version": {
      "description": "モデルの形式 (スキーマ) のバージョン。semver の文字列で、現行は 0.4.0。スキーマを変えたら上げ、古い版のファイルは読み込むときに migrateModel() が現行へ変換する。0.1.0 より前のファイルは整数の 1 を持つ (これも 0.1.0 へ変換する)。",
      "type": "string",
      "const": "0.4.0"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "elements": {
      "description": "全要素。kind で 17 種を判別する。id はモデル内で一意。",
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "relations": {
      "description": "型付きの関係。kind は両端の要素の種類から一意に決まるが、検証と出力を単純にするため冗長に持つ。",
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "boards": {
      "description": "ボードの一覧。1 件以上。要素は複数のボードに置け、座標はボードごとに持つ。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    }
  },
  "$defs": {
    "id": {
      "description": "安定した識別子。作成時に『種類の短い接頭辞 + ランダム文字列』で振り、名前を変えても変わらない。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "description": "表示名。空文字は許す (作成直後など) が、前後の空白は保存時に除く。",
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "description": "説明文。メモ代わりに自由に書ける。",
      "type": "string",
      "maxLength": 4000
    },
    "meta": {
      "description": "モデル全体の情報。",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "elementKind": {
      "description": "要素の種類。",
      "type": "string",
      "enum": [
        "actor",
        "externalActor",
        "system",
        "ledger",
        "business",
        "buc",
        "activity",
        "usecase",
        "context",
        "information",
        "state",
        "variation",
        "condition",
        "issue",
        "event",
        "screen",
        "nfr"
      ]
    },
    "elementBase": {
      "description": "全要素に共通する項目。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/elementKind" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "element": {
      "description": "要素。kind ごとに固有の項目を持つ。",
      "oneOf": [
        { "$ref": "#/$defs/actor" },
        { "$ref": "#/$defs/externalActor" },
        { "$ref": "#/$defs/system" },
        { "$ref": "#/$defs/ledger" },
        { "$ref": "#/$defs/business" },
        { "$ref": "#/$defs/buc" },
        { "$ref": "#/$defs/activity" },
        { "$ref": "#/$defs/usecase" },
        { "$ref": "#/$defs/context" },
        { "$ref": "#/$defs/information" },
        { "$ref": "#/$defs/state" },
        { "$ref": "#/$defs/variation" },
        { "$ref": "#/$defs/condition" },
        { "$ref": "#/$defs/issue" },
        { "$ref": "#/$defs/event" },
        { "$ref": "#/$defs/screen" },
        { "$ref": "#/$defs/nfr" }
      ]
    },
    "actor": {
      "description": "アクター。業務を行う社内の人・役割。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "actor" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "externalActor": {
      "description": "外部アクター。顧客・取引先など社外の人や組織。社外のシステムは system にする。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "externalActor" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "system": {
      "description": "システム。情報システム (自社・社外を問わない)。操作の対象になり、イベントを発生させる。情報の置き場所 (取得元・保存先) は、このシステムを対象にした操作が扱う情報から導く (0.4.0 から)。画面と非機能要件を持てる (screen / nfr の systemId)。作業の担当にはならない (0.2.0 から)。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "system" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "ledger": {
      "description": "帳票。紙の台帳・伝票など。操作の対象になる。情報の置き場所 (取得元・保存先) は、この帳票を対象にした操作が扱う情報から導く (0.4.0 から)。作業の担当にはならない。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "ledger" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "business": {
      "description": "業務。ボード上では枠 (グループノード) になる。作成時に既定 BUC が 1 つ作られる。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "business" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "buc": {
      "description": "BUC (Business Use Case)。業務の中の作業のまとまり。各業務に isDefault: true の既定 BUC がちょうど 1 つある。既定 BUC はボードに置けず、一覧にも出さない。",
      "type": "object",
      "required": ["id", "kind", "name", "businessId", "isDefault"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "buc" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "businessId": {
          "description": "所属する業務の id。必須。",
          "$ref": "#/$defs/id"
        },
        "isDefault": {
          "description": "業務に直接置いたアクティビティを受ける既定 BUC なら true。",
          "type": "boolean"
        }
      }
    },
    "activity": {
      "description": "アクティビティ。業務の中の個々の作業。bucId で所属 BUC を指す。null は未所属。",
      "type": "object",
      "required": ["id", "kind", "name", "bucId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "activity" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "bucId": {
          "description": "所属する BUC の id。業務の枠に直接置いた場合はその業務の既定 BUC。未所属なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "links": {
          "description": "マニュアルなどへのリンク。順序を保つ。",
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "hours": {
          "description": "かかる時間 (時間単位、小数点第一位まで)。任意。",
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "usecase": {
      "description": "ユースケース。システムに期待する振る舞い。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "usecase" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "links": {
          "description": "マニュアルなどへのリンク。順序を保つ。",
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "hours": {
          "description": "かかる時間 (時間単位、小数点第一位まで)。任意。",
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "context": {
      "description": "コンテキスト。役割の同じ情報と、それに関係の深い状態・条件・バリエーションをまとめる親カテゴリ (RDRA のコンテキスト)。所属する要素から contextId で参照され、自身は関係を持たない。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "context" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "information": {
      "description": "情報。業務で扱う情報。contextId で所属コンテキストを指す。null は未分類。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "information" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "state": {
      "description": "状態。情報やモノの状態。group で状態グループ (例: 予約の状態) をまとめる。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "state" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "group": {
          "description": "状態グループ名 (RDRA の state.group)。任意。",
          "type": "string",
          "maxLength": 200
        },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。状態グループごとに同じコンテキストに属する。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "variation": {
      "description": "バリエーション。種別・区分と、その値の一覧。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId", "values"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "variation" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "values": {
          "description": "値の一覧。順序を保つ。",
          "type": "array",
          "items": { "type": "string", "maxLength": 200 }
        },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "condition": {
      "description": "条件。判断の条件・ルール。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "condition" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "issue": {
      "description": "課題。現場で困っていること。ボードには置かず、課題一覧と対象要素のバッジで見る。対象の種類で、全体的な課題 (登場人物が対象) と具体的な課題 (業務・作業・操作・画面が対象) に分かれる (対象が無ければ未整理)。",
      "type": "object",
      "required": ["id", "kind", "name", "severity", "targetIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "issue" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "severity": {
          "description": "重要度。1 (低) 〜 5 (高)。",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "targetIds": {
          "description": "対象要素の id。登場人物 (アクター・外部アクター・システム・帳票) だけ、または業務・作業・操作・画面だけ (混ぜない)。0 件も可 (未整理)。重複なし。",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "analysis": { "$ref": "#/$defs/issueAnalysis" }
      }
    },
    "event": {
      "description": "イベント。操作の実行やシステムが発生させる出来事 (人の動きは含めない)。操作のきっかけになる。contextId で所属コンテキストを指す。null は未分類。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "event" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "screen": {
      "description": "画面。1 つのシステムに属する (systemId)。操作が使う。扱う情報は、この画面を使う操作が扱う情報から導く (0.4.0 から)。",
      "type": "object",
      "required": ["id", "kind", "name", "systemId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "screen" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "systemId": {
          "description": "属するシステムの id。必須 (帳票は画面を持たない)。",
          "$ref": "#/$defs/id"
        }
      }
    },
    "nfr": {
      "description": "非機能要件。1 つのシステムに属する (systemId)。求める人はアクター・外部アクターから関係 (actorNfr) で結ぶ。",
      "type": "object",
      "required": ["id", "kind", "name", "systemId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "nfr" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "systemId": {
          "description": "属するシステムの id。必須 (帳票は非機能要件を持たない)。",
          "$ref": "#/$defs/id"
        },
        "category": {
          "description": "分類 (IPA 非機能要求グレードの大項目)。省略は未分類。availability: 可用性、performance: 性能・拡張性、operability: 運用・保守性、migration: 移行性、security: セキュリティ、environment: システム環境・エコロジー。",
          "type": "string",
          "enum": ["availability", "performance", "operability", "migration", "security", "environment"]
        },
        "verification": {
          "description": "検証方法。満たしていることをどう確かめるか。",
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "issueAnalysis": {
      "description": "課題の分析 (任意)。AI との深掘りや手入力で埋める。担当者が書いた課題の説明 (原文) は残し、突き止めた内容をここに分けて持つ。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phenomenon": { "description": "現象。何が、いつ、どのくらいの頻度で起きるか。", "type": "string", "maxLength": 4000 },
        "location": { "description": "所在。どの業務・活動・作業・操作 (または登場人物) で起きるか。", "type": "string", "maxLength": 4000 },
        "cause": { "description": "理由。なぜそこで起きるか。", "type": "string", "maxLength": 4000 },
        "impact": { "description": "影響。誰にどう響くか。", "type": "string", "maxLength": 4000 }
      }
    },
    "link": {
      "description": "リンク。表示名と URL (http / https)。",
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://" }
      }
    },
    "relationKind": {
      "description": "関係の種類。両端の要素の種類から一意に決まる。",
      "type": "string",
      "enum": [
        "actorBusiness",
        "actorActivity",
        "activityUsecase",
        "usecaseInformation",
        "usecaseCondition",
        "informationRelated",
        "informationVariation",
        "conditionVariation",
        "conditionState",
        "stateUsecase",
        "usecaseState",
        "usecaseSystem",
        "usecaseEvent",
        "systemEvent",
        "eventUsecase",
        "usecaseNext",
        "usecaseScreen",
        "actorNfr"
      ]
    },
    "relation": {
      "description": "型付きの関係。同じ (kind, sourceId, targetId) は 1 本まで。informationRelated は無向で、(a, b) と (b, a) を同一とみなす。自己参照は不可 (usecaseNext の自分自身への「次に」も不可)。1 つの操作が持てる対象は、usecaseSystem (システム・帳票) と usecaseScreen (画面) を合わせて 1 本まで (0.3.0 から。validateModel で検査する)。情報の置き場所 (システム・帳票の取得元・保存先) と画面が扱う情報は保存せず、操作が扱う情報 (usecaseInformation) と操作の対象から導く (0.4.0 から)。",
      "type": "object",
      "required": ["id", "kind", "sourceId", "targetId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/relationKind" },
        "sourceId": {
          "description": "始点の要素 id。",
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "description": "終点の要素 id。",
          "$ref": "#/$defs/id"
        },
        "access": {
          "description": "操作が情報をどう扱うか (usecaseInformation だけに付ける。validateModel で検査する)。read: 取得 (読む)、write: 保存 (書く)。省略は取得も保存もする。導いた置き場所の取得元・保存先はこれで決まる。",
          "type": "string",
          "enum": ["read", "write"]
        }
      }
    },
    "board": {
      "description": "ボード。要素をどこに置くかだけを持ち、業務データは持たない。",
      "type": "object",
      "required": ["id", "name", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "nodes": {
          "description": "このボードに置かれた要素と座標。同じ elementId は 1 件まで。課題と既定 BUC は置けない。",
          "type": "array",
          "items": { "$ref": "#/$defs/boardNode" }
        },
        "edges": {
          "description": "このボードでの線の見た目。省略した線は既定 (始点の右から終点の左へ)。同じ relationId は 1 件まで。",
          "type": "array",
          "items": { "$ref": "#/$defs/boardEdge" }
        }
      }
    },
    "boardNode": {
      "description": "ボード上の要素の配置。座標はボード内の絶対座標 (親の枠に入っていても相対にしない)。",
      "type": "object",
      "required": ["elementId", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "elementId": { "$ref": "#/$defs/id" },
