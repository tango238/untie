{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:untie:schema:model:1",
  "title": "UntieModel",
  "description": "Untie の業務モデル。要素 (elements) と型付きの関係 (relations) と、要素をどこに置くかだけを持つボード (boards) から成る。要素・関係・ボードは安定した id を持ち、参照はすべて id で行う。参照整合性はスキーマでは表現できないので validateModel() で別途検査する。",
  "type": "object",
  "required": ["version", "meta", "elements", "relations", "boards", "designs", "databases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "任意。エディタ補完用のスキーマ参照。",
      "type": "string"
    },
    "version": {
      "description": "モデルの形式 (スキーマ) のバージョン。semver の文字列で、現行は 0.5.4。スキーマを変えたら上げ、古い版のファイルは読み込むときに migrateModel() が現行へ変換する。0.1.0 より前のファイルは整数の 1 を持つ (これも 0.1.0 へ変換する)。",
      "type": "string",
      "const": "0.5.4"
    },
    "meta": { "$ref": "#/$defs/meta" },
    "elements": {
      "description": "全要素。kind で 17 種を判別する。id はモデル内で一意。",
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "relations": {
      "description": "型付きの関係。kind は両端の要素の種類から一意に決まるが、検証と出力を単純にするため冗長に持つ。",
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "boards": {
      "description": "ボードの一覧。1 件以上。要素は複数のボードに置け、座標はボードごとに持つ。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    },
    "designs": {
      "description": "システムごとの設計 (設計モード。0.5.0 から)。systemId は一意。参照整合性は validateModel() で検査する。",
      "type": "array",
      "items": { "$ref": "#/$defs/systemDesign" }
    },
    "databases": {
      "description": "設計をまたいで共有するデータベース (0.5.0 から)。id は一意。",
      "type": "array",
      "items": { "$ref": "#/$defs/database" }
    }
  },
  "$defs": {
    "id": {
      "description": "安定した識別子。作成時に『種類の短い接頭辞 + ランダム文字列』で振り、名前を変えても変わらない。",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "description": "表示名。空文字は許す (作成直後など) が、前後の空白は保存時に除く。",
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "description": "説明文。メモ代わりに自由に書ける。",
      "type": "string",
      "maxLength": 4000
    },
    "meta": {
      "description": "モデル全体の情報。",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "elementKind": {
      "description": "要素の種類。",
      "type": "string",
      "enum": [
        "actor",
        "externalActor",
        "system",
        "ledger",
        "business",
        "buc",
        "activity",
        "usecase",
        "context",
        "information",
        "state",
        "variation",
        "condition",
        "issue",
        "event",
        "screen",
        "nfr"
      ]
    },
    "elementBase": {
      "description": "全要素に共通する項目。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/elementKind" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "element": {
      "description": "要素。kind ごとに固有の項目を持つ。",
      "oneOf": [
        { "$ref": "#/$defs/actor" },
        { "$ref": "#/$defs/externalActor" },
        { "$ref": "#/$defs/system" },
        { "$ref": "#/$defs/ledger" },
        { "$ref": "#/$defs/business" },
        { "$ref": "#/$defs/buc" },
        { "$ref": "#/$defs/activity" },
        { "$ref": "#/$defs/usecase" },
        { "$ref": "#/$defs/context" },
        { "$ref": "#/$defs/information" },
        { "$ref": "#/$defs/state" },
        { "$ref": "#/$defs/variation" },
        { "$ref": "#/$defs/condition" },
        { "$ref": "#/$defs/issue" },
        { "$ref": "#/$defs/event" },
        { "$ref": "#/$defs/screen" },
        { "$ref": "#/$defs/nfr" }
      ]
    },
    "actor": {
      "description": "アクター。業務を行う社内の人・役割。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "actor" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "persona": { "$ref": "#/$defs/persona" }
      }
    },
    "externalActor": {
      "description": "外部アクター。顧客・取引先など社外の人や組織。社外のシステムは system にする。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "externalActor" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "persona": { "$ref": "#/$defs/persona" }
      }
    },
    "system": {
      "description": "システム。情報システム (自社・社外を問わない)。操作の対象になり、イベントを発生させる。情報の置き場所 (取得元・保存先) は、このシステムを対象にした操作が扱う情報から導く (0.4.0 から)。画面と非機能要件を持てる (screen / nfr の systemId)。作業の担当にはならない (0.2.0 から)。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "system" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "ledger": {
      "description": "帳票。紙の台帳・伝票など。操作の対象になる。情報の置き場所 (取得元・保存先) は、この帳票を対象にした操作が扱う情報から導く (0.4.0 から)。作業の担当にはならない。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "ledger" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "business": {
      "description": "業務。ボード上では枠 (グループノード) になる。作成時に既定 BUC が 1 つ作られる。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "business" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "buc": {
      "description": "BUC (Business Use Case)。業務の中の作業のまとまり。各業務に isDefault: true の既定 BUC がちょうど 1 つある。既定 BUC はボードに置けず、一覧にも出さない。",
      "type": "object",
      "required": ["id", "kind", "name", "businessId", "isDefault"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "buc" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "businessId": {
          "description": "所属する業務の id。必須。",
          "$ref": "#/$defs/id"
        },
        "isDefault": {
          "description": "業務に直接置いたアクティビティを受ける既定 BUC なら true。",
          "type": "boolean"
        }
      }
    },
    "activity": {
      "description": "アクティビティ。業務の中の個々の作業。bucId で所属 BUC を指す。null は未所属。",
      "type": "object",
      "required": ["id", "kind", "name", "bucId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "activity" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "bucId": {
          "description": "所属する BUC の id。業務の枠に直接置いた場合はその業務の既定 BUC。未所属なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "links": {
          "description": "マニュアルなどへのリンク。順序を保つ。",
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "hours": {
          "description": "かかる時間 (時間単位、小数点第一位まで)。任意。",
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "triggerNote": {
          "description": "起点のうち、作業・イベント以外の自由入力 (例: 電話)。空文字は持たず、無ければ項目ごと省く (0.4.1 から)。",
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "usecase": {
      "description": "ユースケース。システムに期待する振る舞い。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "usecase" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "links": {
          "description": "マニュアルなどへのリンク。順序を保つ。",
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "hours": {
          "description": "かかる時間 (時間単位、小数点第一位まで)。任意。",
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "context": {
      "description": "コンテキスト。役割の同じ情報と、それに関係の深い状態・条件・バリエーションをまとめる親カテゴリ (RDRA のコンテキスト)。所属する要素から contextId で参照され、自身は関係を持たない。",
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "context" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "information": {
      "description": "情報。業務で扱う情報。contextId で所属コンテキストを指す。null は未分類。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "information" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "state": {
      "description": "状態。情報やモノの状態。group で状態グループ (例: 予約の状態) をまとめる。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "state" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "group": {
          "description": "状態グループ名 (RDRA の state.group)。任意。",
          "type": "string",
          "maxLength": 200
        },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。状態グループごとに同じコンテキストに属する。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "variation": {
      "description": "バリエーション。種別・区分と、その値の一覧。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId", "values"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "variation" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "values": {
          "description": "値の一覧。順序を保つ。",
          "type": "array",
          "items": { "type": "string", "maxLength": 200 }
        },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "condition": {
      "description": "条件。判断の条件・ルール。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "condition" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      }
    },
    "issue": {
      "description": "課題。現場で困っていること。ボードには置かず、課題一覧と対象要素のバッジで見る。対象の種類で、全体的な課題 (登場人物が対象) と具体的な課題 (業務・作業・操作・画面が対象) に分かれる (対象が無ければ未整理)。",
      "type": "object",
      "required": ["id", "kind", "name", "severity", "targetIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "issue" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "severity": {
          "description": "重要度。1 (低) 〜 5 (高)。",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "targetIds": {
          "description": "対象要素の id。登場人物 (アクター・外部アクター・システム・帳票) だけ、または業務・作業・操作・画面だけ (混ぜない)。0 件も可 (未整理)。重複なし。",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "analysis": { "$ref": "#/$defs/issueAnalysis" }
      }
    },
    "event": {
      "description": "イベント。操作の実行やシステムが発生させる出来事 (人の動きは含めない)。操作のきっかけになる。contextId で所属コンテキストを指す。null は未分類。",
      "type": "object",
      "required": ["id", "kind", "name", "contextId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "event" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "contextId": {
          "description": "所属するコンテキストの id。未分類なら null。",
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "timing": { "$ref": "#/$defs/eventTiming" }
      }
    },
    "eventTiming": {
      "description": "イベントの発生タイミング (任意。0.5.4 から)。type が scheduled (定期) なら、every の周期 (毎月・毎日・毎時) で繰り返すバッチ処理で、day・hour・minute で起きる時刻を決める。adhoc (不定期・随時) なら、Webhook などから API が呼ばれたときのような不定期の処理で、いつ起きるかは note に書く。",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "description": "種類。scheduled は定期、adhoc は不定期 (随時)。", "enum": ["scheduled", "adhoc"] },
        "every": { "description": "定期の周期。month は毎月、day は毎日、hour は毎時。type が scheduled のときだけ持つ。", "enum": ["month", "day", "hour"] },
        "day": { "description": "毎月の何日に起きるか (1〜31。月末に無い日はその月の末日)。every が month のときだけ持つ。", "type": "integer", "minimum": 1, "maximum": 31 },
        "hour": { "description": "何時に起きるか (0〜23)。every が month か day のときだけ持つ。", "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "description": "何分に起きるか (0〜59)。type が scheduled のときだけ持つ。", "type": "integer", "minimum": 0, "maximum": 59 },
        "note": { "description": "補足。定期なら「営業日だけ」など、不定期ならいつ起きるか (例: 決済サービスから入金の Webhook を受けたとき)。", "type": "string", "maxLength": 4000 }
      }
    },
    "screen": {
      "description": "画面。1 つのシステムに属する (systemId)。操作が使う。扱う情報は、この画面を使う操作が扱う情報から導く (0.4.0 から)。",
      "type": "object",
      "required": ["id", "kind", "name", "systemId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "screen" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "systemId": {
          "description": "属するシステムの id。必須 (帳票は画面を持たない)。",
          "$ref": "#/$defs/id"
        }
      }
    },
    "nfr": {
      "description": "非機能要件。1 つのシステムに属する (systemId)。求める人はアクター・外部アクターから関係 (actorNfr) で結ぶ。",
      "type": "object",
      "required": ["id", "kind", "name", "systemId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "nfr" },
        "name": { "$ref": "#/$defs/name" },
        "description": { "$ref": "#/$defs/description" },
        "systemId": {
          "description": "属するシステムの id。必須 (帳票は非機能要件を持たない)。",
          "$ref": "#/$defs/id"
        },
        "category": {
          "description": "分類 (IPA 非機能要求グレードの大項目)。省略は未分類。availability: 可用性、performance: 性能・拡張性、operability: 運用・保守性、migration: 移行性、security: セキュリティ、environment: システム環境・エコロジー。",
          "type": "string",
          "enum": ["availability", "performance", "operability", "migration", "security", "environment"]
        },
        "verification": {
          "description": "検証方法。満たしていることをどう確かめるか。",
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "persona": {
      "description": "ペルソナ (任意)。アクター・外部アクターの人物像。AI のヒアリングで、この人になりきって答える材料になる。項目はすべて任意で、全部空なら持たない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handle": { "description": "呼び名。例: 田中さん (店長・45歳)。", "type": "string", "maxLength": 200 },
        "attributes": { "description": "属性。年代・経験年数・勤務形態などを 1 行で。", "type": "string", "maxLength": 200 },
        "background": { "description": "背景と役割。何を任され、何を気にしているか。", "type": "string", "maxLength": 4000 },
        "goals": { "description": "目標。この人が達成したいこと。", "type": "string", "maxLength": 4000 },
        "itSkill": { "description": "IT の習熟。comfortable は慣れている、normal は普通、uncomfortable は苦手。", "enum": ["comfortable", "normal", "uncomfortable"] },
        "notes": { "description": "備考。", "type": "string", "maxLength": 4000 }
      }
    },
    "issueAnalysis": {
      "description": "課題の分析 (任意)。AI との深掘りや手入力で埋める。担当者が書いた課題の説明 (原文) は残し、突き止めた内容をここに分けて持つ。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phenomenon": { "description": "現象。何が、いつ、どのくらいの頻度で起きるか。", "type": "string", "maxLength": 4000 },
        "location": { "description": "所在。どの業務・活動・作業・操作 (または登場人物) で起きるか。", "type": "string", "maxLength": 4000 },
        "cause": { "description": "理由。なぜそこで起きるか。", "type": "string", "maxLength": 4000 },
        "impact": { "description": "影響。誰にどう響くか。", "type": "string", "maxLength": 4000 }
      }
    },
    "link": {
      "description": "リンク。表示名と URL (http / https)。",
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://" }
      }
    },
    "relationKind": {
      "description": "関係の種類。両端の要素の種類から一意に決まる。",
      "type": "string",
      "enum": [
        "actorBusiness",
        "actorActivity",
        "activityUsecase",
        "usecaseInformation",
        "usecaseCondition",
        "informationRelated",
        "informationVariation",
        "conditionVariation",
        "conditionState",
        "stateUsecase",
        "usecaseState",
        "usecaseSystem",
        "usecaseEvent",
        "systemEvent",
        "eventUsecase",
        "usecaseNext",
        "activityTrigger",
        "eventActivity",
        "usecaseScreen",
        "actorNfr"
      ]
    },
    "relation": {
      "description": "型付きの関係。同じ (kind, sourceId, targetId) は 1 本まで。informationRelated は無向で、(a, b) と (b, a) を同一とみなす。自己参照は不可 (usecaseNext の自分自身への「次に」、activityTrigger の自分自身への起点も不可)。activityTrigger (作業 → 作業) と eventActivity (イベント → 作業) は作業の起点で、起点の循環は許す (0.4.1 から)。1 つの操作が持てる対象は、usecaseSystem (システム・帳票) と usecaseScreen (画面) を合わせて 1 本まで (0.3.0 から。validateModel で検査する)。情報の置き場所 (システム・帳票の取得元・保存先) と画面が扱う情報は保存せず、操作が扱う情報 (usecaseInformation) と操作の対象から導く (0.4.0 から)。",
      "type": "object",
      "required": ["id", "kind", "sourceId", "targetId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/relationKind" },
        "sourceId": {
          "description": "始点の要素 id。",
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "description": "終点の要素 id。",
          "$ref": "#/$defs/id"
        },
        "access": {
          "description": "操作が情報をどう扱うか (usecaseInformation だけに付ける。validateModel で検査する)。read: 取得 (読む)、write: 保存 (書く)。省略は取得も保存もする。導いた置き場所の取得元・保存先はこれで決まる。",
          "type": "string",
          "enum": ["read", "write"]
        }
      }
    },
  "systemDesign": {
      "description": "1 つのシステムの設計。サイトマップ (画面と遷移)・レイアウト・画面 UI・データベースへの対応を持つ。",
      "type": "object",
      "required": [
        "systemId",
        "databaseIds",
        "screens",
        "transitions",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "systemId": {
          "description": "elements の system の id。",
          "$ref": "#/$defs/id"
        },
        "databaseIds": {
          "description": "使うデータベース (databases の id)。空なら既定のデータベース。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "screens": {
          "description": "サイトマップの画面。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/designScreen"
          }
        },
        "transitions": {
          "description": "画面遷移。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "designScreen": {
      "description": "サイトマップの画面 1 つ。分析の画面を指すか、組み込みの画面。id は設計をまたいで一意。",
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "screenId"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "screen"
                },
                "screenId": {
                  "description": "分析の画面 (screen 要素) の id。同じシステムの画面だけ指せる。",
                  "$ref": "#/$defs/id"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "builtin"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "builtin"
                },
                "builtin": {
                  "enum": [
                    "signIn",
                    "home",
                    "top",
                    "signUp",
                    "passwordReminder"
                  ]
                }
              }
            }
          ]
        },
        "shell": {
          "description": "この画面のレイアウト (枠)。省略は設計のレイアウト (layout.shell) に従う。",
          "enum": [
            "shell",
            "plain"
          ]
        },
        "view": {
          "description": "画面 UI (mokkun v2 の ViewV2 を JSON で持つ)。中身は検証しない。",
          "type": "object",
          "additionalProperties": true
        },
        "bindings": {
          "description": "画面の項目とテーブルの列の対応。",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "databaseId",
              "table",
              "column"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "$ref": "#/$defs/name"
              },
              "databaseId": {
                "$ref": "#/$defs/id"
              },
              "table": {
                "$ref": "#/$defs/name"
              },
              "column": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    },
    "transition": {
      "description": "画面遷移。from と to は同じ設計の画面 (DesignScreen.id)。id は設計をまたいで一意。",
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "via": {
          "description": "遷移のきっかけ。省略は未定。",
          "enum": [
            "button",
            "row",
            "nav",
            "afterSubmit"
          ]
        },
        "label": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "layout": {
      "description": "システム共通のレイアウト。",
      "type": "object",
      "required": [
        "shell",
        "navigation"
      ],
      "additionalProperties": false,
      "properties": {
        "shell": {
          "description": "shell は共通の枠 (ヘッダー・ナビ) つき、plain は枠なし。",
          "enum": [
            "shell",
            "plain"
          ]
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "systemName": {
              "$ref": "#/$defs/name"
            },
            "userName": {
              "$ref": "#/$defs/name"
            },
            "tenantName": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "navigation": {
          "description": "ナビゲーション。グループごとに画面を並べる。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/navGroup"
          }
        }
      }
    },
    "navGroup": {
      "description": "ナビゲーションのグループ。id は設計をまたいで一意 (同時編集で別々に足しても合流できるようにするため)。",
      "type": "object",
      "required": [
        "id",
        "group",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "group": {
          "$ref": "#/$defs/name"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "screenId"
            ],
            "additionalProperties": false,
            "properties": {
              "screenId": {
                "description": "DesignScreen.id",
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    },
    "database": {
      "description": "データベース。設計をまたいで共有する。",
      "type": "object",
      "required": [
        "id",
        "name",
        "dsl",
        "tables"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "dsl": {
          "description": "Prisma 風の DSL (今は解析しない)。",
          "type": "string",
          "maxLength": 200000
        },
        "tables": {
          "description": "テーブルと、それが表す情報 (1 つの情報に複数のテーブルがあってよい)。",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "table",
              "informationIds"
            ],
            "additionalProperties": false,
            "properties": {
              "table": {
                "$ref": "#/$defs/name"
              },
              "informationIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "board": {
      "description": "ボード。要素をどこに置くかだけを持ち、業務データは持たない。",
      "type": "object",
      "required": ["id", "name", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "nodes": {
          "description": "このボードに置かれた要素と座標。同じ elementId は 1 件まで。課題と既定 BUC は置けない。",
          "type": "array",
          "items": { "$ref": "#/$defs/boardNode" }
        },
        "edges": {
          "description": "このボードでの線の見た目。省略した線は既定 (始点の右から終点の左へ)。同じ relationId は 1 件まで。",
          "type": "array",
          "items": { "$ref": "#/$defs/boardEdge" }
        }
      }
    },
    "boardNode": {
      "description": "ボード上の要素の配置。座標はボード内の絶対座標 (親の枠に入っていても相対にしない)。",
      "type": "object",
      "required": ["elementId", "x", "y"],
      "additionalProperties": false,
      "properties": {
        "elementId": { "$ref": "#/$defs/id" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": {
          "description": "枠 (業務・BUC) の幅。カードでは省略し、表示側の既定サイズを使う。",
          "type": "number",
          "minimum": 1
        },
        "height": {
          "description": "枠 (業務・BUC) の高さ。",
          "type": "number",
          "minimum": 1
        }
      }
    },
    "boardEdge": {
      "description": "ボード上の線の見た目。どちらの辺から出て、どちらの辺に入るかをボードごとに持つ。",
      "type": "object",
      "required": ["relationId"],
      "additionalProperties": false,
      "properties": {
        "relationId": { "$ref": "#/$defs/id" },
        "sourceSide": {
          "description": "始点の要素のどの辺から線を出すか。省略時は right。",
          "$ref": "#/$defs/edgeSide"
        },
        "targetSide": {
          "description": "終点の要素のどの辺に線を入れるか。省略時は left。",
          "$ref": "#/$defs/edgeSide"
        }
      }
    },
    "edgeSide": {
      "description": "要素の辺。",
      "type": "string",
      "enum": ["left", "right", "top", "bottom"]
    }
  }
}
