// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 会計システム
//
// 状態は data (グループごとに、どれか 1 つの値)、操作は behavior。操作は今の状態を受け取り、前提の状態でなければ「状態が違う」を返す。
// 条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れ・前提の状態が違うとき・条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_accounting

// ---- 状態

data n1_日の締めの状態 = 営業中 | 現金確認済 | 突き合わせ済 | 報告済 | 入金済

data 売掛金の状態 = 未入金 | 一部入金 | 消込済

// ---- 操作

// 操作: 売上を本部へ送る
//   作業: 売上を本部へ報告する (担当: 店長・本部の仕入担当)
//   保存する情報: 売上
behavior 売上を本部へ送る : (今の1_日の締めの状態: n1_日の締めの状態) -> 報告済 | 売上を本部へ送る_状態が違う
let 売上を本部へ送る (今の1_日の締めの状態) = {
    guard 今の1_日の締めの状態 == 突き合わせ済 else 売上を本部へ送る_状態が違う
    報告済
}
example 売上を本部へ送る
    | "ふだんの流れ: 突き合わせ済 から → 報告済" : (突き合わせ済) -> 報告済
    | "前提の状態が違う: 営業中 では行えない" : (営業中) -> 売上を本部へ送る_状態が違う
    | "前提の状態が違う: 現金確認済 では行えない" : (現金確認済) -> 売上を本部へ送る_状態が違う
    | "前提の状態が違う: 報告済 では行えない" : (報告済) -> 売上を本部へ送る_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済) -> 売上を本部へ送る_状態が違う

// 操作: 売掛金を消し込む
//   作業: 入金を消し込む (担当: 本部の経理担当)
//   取得する情報: 売掛金・入金
//   保存する情報: 売掛金
behavior 売掛金を消し込む : (今の売掛金の状態: 売掛金の状態) -> 一部入金 | 消込済 | 売掛金を消し込む_状態が違う
// 次の状態が決まっていないので、中身はまだ書けない (行は、何が要るかを記録するだけ)
example 売掛金を消し込む
    | "ふだんの流れ: 未入金 から → 一部入金 か 消込済" : (未入金) -> <?>
    | "ふだんの流れ: 一部入金 から → 一部入金 か 消込済" : (一部入金) -> <?>
    | "前提の状態が違う: 消込済 では行えない" : (消込済) -> 売掛金を消し込む_状態が違う

// ---- 書き出していない操作 (前提の状態も、判断する条件も無いので、確かめる組み合わせが無い)
//   売掛金を登録する
//   入金を登録する
//   損益計算書を見る
