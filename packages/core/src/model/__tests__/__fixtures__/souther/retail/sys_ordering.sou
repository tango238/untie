// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 本部の発注システム
//
// 状態は data、操作は behavior。条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れと、条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_ordering

// ---- 状態

data 発注の状態 = 発注済 | 入荷済 | 数が足りない

// ---- 操作

// 操作: 発注を登録する
//   作業: 発注する (担当: 店長)
//   取得する情報: 発注・商品
//   保存する情報: 発注
//   棚の在庫が少ない でないとき: 発注せず、次の確認まで待つ。
behavior 発注を登録する : (前の発注の状態: 数が足りない, 棚の在庫が少ない: Bool) -> 発注済 | 発注を登録する_棚の在庫が少ない_でない
let 発注を登録する (前の発注の状態, 棚の在庫が少ない) = {
    guard 棚の在庫が少ない else 発注を登録する_棚の在庫が少ない_でない
    発注済
}
example 発注を登録する
    | "ふだんの流れ: 数が足りない から → 発注済" : (数が足りない, true) -> 発注済
    | "棚の在庫が少ない でないとき: 発注せず、次の確認まで待つ。" : (数が足りない, false) -> 発注を登録する_棚の在庫が少ない_でない

// ---- 書き出していない操作 (前提の状態も、判断する条件も無いので、確かめる組み合わせが無い)
//   取り寄せを登録する
