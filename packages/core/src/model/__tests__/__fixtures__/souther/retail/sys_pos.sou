// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: POSレジ
//
// 状態は data (グループごとに、どれか 1 つの値)、操作は behavior。操作は今の状態を受け取り、前提の状態でなければ「状態が違う」を返す。
// 条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れ・前提の状態が違うとき・条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_pos

// ---- 状態

data 発注の状態 = 発注済 | 入荷済 | 数が足りない

data n1_日の締めの状態 = 営業中 | 現金確認済 | 突き合わせ済 | 報告済 | 入金済

// ---- 操作

// 操作: 売価を変更する
//   作業: 売価・値札を直す (担当: 売場担当)
//   取得する情報: 商品
//   保存する情報: 商品
behavior 売価を変更する : (今の発注の状態: 発注の状態) -> 売価を変更する_完了 | 売価を変更する_状態が違う
let 売価を変更する (今の発注の状態) = {
    guard 今の発注の状態 == 入荷済 else 売価を変更する_状態が違う
    売価を変更する_完了
}
example 売価を変更する
    | "ふだんの流れ: 入荷済 から → 完了" : (入荷済) -> 売価を変更する_完了
    | "前提の状態が違う: 発注済 では行えない" : (発注済) -> 売価を変更する_状態が違う
    | "前提の状態が違う: 数が足りない では行えない" : (数が足りない) -> 売価を変更する_状態が違う

// 操作: 売上を登録する
//   作業: 商品を読み取る (担当: レジ担当・来店客)
//   取得する情報: 売上・商品・在庫
//   保存する情報: 売上・在庫
behavior 売上を登録する : (今の1_日の締めの状態: n1_日の締めの状態) -> 営業中 | 売上を登録する_状態が違う
let 売上を登録する (今の1_日の締めの状態) = {
    guard 今の1_日の締めの状態 == 営業中 else 売上を登録する_状態が違う
    営業中
}
example 売上を登録する
    | "ふだんの流れ: 営業中 から → 営業中" : (営業中) -> 営業中
    | "前提の状態が違う: 現金確認済 では行えない" : (現金確認済) -> 売上を登録する_状態が違う
    | "前提の状態が違う: 突き合わせ済 では行えない" : (突き合わせ済) -> 売上を登録する_状態が違う
    | "前提の状態が違う: 報告済 では行えない" : (報告済) -> 売上を登録する_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済) -> 売上を登録する_状態が違う

// 操作: 返品・交換を登録する
//   作業: 返品・交換に応じる (担当: レジ担当・店長・来店客)
//   取得する情報: 売上・在庫
//   保存する情報: 売上・在庫
//   レシートがある でないとき: 返品・交換を受けず、理由をお客様に伝える。 [そのあとの状態: 変えない]
behavior 返品_交換を登録する : (今の1_日の締めの状態: n1_日の締めの状態, レシートがある: Bool) -> 返品_交換を登録する_完了 | 返品_交換を登録する_レシートがある_でない | 返品_交換を登録する_状態が違う
let 返品_交換を登録する (今の1_日の締めの状態, レシートがある) = {
    guard 今の1_日の締めの状態 == 営業中 else 返品_交換を登録する_状態が違う
    guard レシートがある else 返品_交換を登録する_レシートがある_でない
    返品_交換を登録する_完了
}
example 返品_交換を登録する
    | "ふだんの流れ: 営業中 から → 完了" : (営業中, true) -> 返品_交換を登録する_完了
    | "前提の状態が違う: 現金確認済 では行えない" : (現金確認済, true) -> 返品_交換を登録する_状態が違う
    | "前提の状態が違う: 突き合わせ済 では行えない" : (突き合わせ済, true) -> 返品_交換を登録する_状態が違う
    | "前提の状態が違う: 報告済 では行えない" : (報告済, true) -> 返品_交換を登録する_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済, true) -> 返品_交換を登録する_状態が違う
    | "レシートがある でないとき: 返品・交換を受けず、理由をお客様に伝える。" : (営業中, false) -> 返品_交換を登録する_レシートがある_でない

// 操作: 現金の実際の額を記録する
//   作業: 現金を数える (担当: レジ担当)
//   取得する情報: 現金・支払
//   保存する情報: 現金・支払
//   売上と現金にずれがあるとき: 原因を調べて、ずれの理由を記録してから報告する。 [そのあとの状態: ふだんと同じ]
data 現金の実際の額を記録する_売上と現金にずれがある = { n1_日の締めの状態: n1_日の締めの状態 }
behavior 現金の実際の額を記録する : (今の1_日の締めの状態: n1_日の締めの状態, 売上と現金にずれがある: Bool) -> 現金確認済 | 現金の実際の額を記録する_売上と現金にずれがある | 現金の実際の額を記録する_状態が違う
let 現金の実際の額を記録する (今の1_日の締めの状態, 売上と現金にずれがある) = {
    guard 今の1_日の締めの状態 == 営業中 else 現金の実際の額を記録する_状態が違う
    guard Bool.not(売上と現金にずれがある) else 現金の実際の額を記録する_売上と現金にずれがある { n1_日の締めの状態 = 現金確認済 }
    現金確認済
}
example 現金の実際の額を記録する
    | "ふだんの流れ: 営業中 から → 現金確認済" : (営業中, false) -> 現金確認済
    | "前提の状態が違う: 現金確認済 では行えない" : (現金確認済, false) -> 現金の実際の額を記録する_状態が違う
    | "前提の状態が違う: 突き合わせ済 では行えない" : (突き合わせ済, false) -> 現金の実際の額を記録する_状態が違う
    | "前提の状態が違う: 報告済 では行えない" : (報告済, false) -> 現金の実際の額を記録する_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済, false) -> 現金の実際の額を記録する_状態が違う
    | "売上と現金にずれがあるとき: 原因を調べて、ずれの理由を記録してから報告する。" : (営業中, true) -> 現金の実際の額を記録する_売上と現金にずれがある { n1_日の締めの状態 = 現金確認済 }

// 操作: 日次の売上を出力する
//   作業: 売上と現金を突き合わせる (担当: レジ担当)
//   取得する情報: 売上・現金・支払
behavior 日次の売上を出力する : (今の1_日の締めの状態: n1_日の締めの状態) -> 突き合わせ済 | 日次の売上を出力する_状態が違う
let 日次の売上を出力する (今の1_日の締めの状態) = {
    guard 今の1_日の締めの状態 == 現金確認済 else 日次の売上を出力する_状態が違う
    突き合わせ済
}
example 日次の売上を出力する
    | "ふだんの流れ: 現金確認済 から → 突き合わせ済" : (現金確認済) -> 突き合わせ済
    | "前提の状態が違う: 営業中 では行えない" : (営業中) -> 日次の売上を出力する_状態が違う
    | "前提の状態が違う: 突き合わせ済 では行えない" : (突き合わせ済) -> 日次の売上を出力する_状態が違う
    | "前提の状態が違う: 報告済 では行えない" : (報告済) -> 日次の売上を出力する_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済) -> 日次の売上を出力する_状態が違う

// ---- 書き出していない操作 (前提の状態も、判断する条件も無いので、確かめる組み合わせが無い)
//   商品と在庫を検索する
//   値引き・廃棄を記録する
