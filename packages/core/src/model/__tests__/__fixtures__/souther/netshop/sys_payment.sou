// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 決済サービス
//
// 状態は data、操作は behavior。条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れと、条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_payment

// ---- 状態

data 注文の状態 = 受付済 | 確定 | 入金済 | 出荷済 | 取消

data 返品の状態 = 返品受付 | 検品済 | 返金済

// ---- 操作

// 操作: 入金を記録する
//   作業: 入金を確認する (担当: 受注担当)
//   取得する情報: 注文
//   起きる出来事: 入金が確認された
behavior 入金を記録する : (前の注文の状態: 確定) -> 入金済
let 入金を記録する (前の注文の状態) = 入金済
example 入金を記録する
    | "ふだんの流れ: 確定 から → 入金済" : (確定) -> 入金済

// 操作: 返金を記録する
//   作業: 返金・交換を手配する (担当: カスタマーサポート・店長)
//   取得する情報: 返品
//   起きる出来事: 返金が記録された
behavior 返金を記録する : (前の返品の状態: 検品済) -> 返金済
let 返金を記録する (前の返品の状態) = 返金済
example 返金を記録する
    | "ふだんの流れ: 検品済 から → 返金済" : (検品済) -> 返金済
