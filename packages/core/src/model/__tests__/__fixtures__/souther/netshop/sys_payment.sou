// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 決済サービス
//
// 状態は data (グループごとに、どれか 1 つの値)、操作は behavior。操作は今の状態を受け取り、前提の状態でなければ「状態が違う」を返す。
// 条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れ・前提の状態が違うとき・条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_payment

// ---- 状態

data 注文の状態 = 受付済 | 確定 | 入金済 | 出荷済 | 取消

data 返品の状態 = 返品受付 | 検品済 | 返金済

// ---- 操作

// 操作: 入金を記録する
//   作業: 入金を確認する (担当: 受注担当)
//   取得する情報: 注文
//   起きる出来事: 入金が確認された
behavior 入金を記録する : (今の注文の状態: 注文の状態) -> 入金済 | 入金を記録する_状態が違う
let 入金を記録する (今の注文の状態) = {
    guard 今の注文の状態 == 確定 else 入金を記録する_状態が違う
    入金済
}
example 入金を記録する
    | "ふだんの流れ: 確定 から → 入金済" : (確定) -> 入金済
    | "前提の状態が違う: 受付済 では行えない" : (受付済) -> 入金を記録する_状態が違う
    | "前提の状態が違う: 入金済 では行えない" : (入金済) -> 入金を記録する_状態が違う
    | "前提の状態が違う: 出荷済 では行えない" : (出荷済) -> 入金を記録する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消) -> 入金を記録する_状態が違う

// 操作: 返金を記録する
//   作業: 返金・交換を手配する (担当: カスタマーサポート・店長)
//   取得する情報: 返品
//   起きる出来事: 返金が記録された
behavior 返金を記録する : (今の返品の状態: 返品の状態) -> 返金済 | 返金を記録する_状態が違う
let 返金を記録する (今の返品の状態) = {
    guard 今の返品の状態 == 検品済 else 返金を記録する_状態が違う
    返金済
}
example 返金を記録する
    | "ふだんの流れ: 検品済 から → 返金済" : (検品済) -> 返金済
    | "前提の状態が違う: 返品受付 では行えない" : (返品受付) -> 返金を記録する_状態が違う
    | "前提の状態が違う: 返金済 では行えない" : (返金済) -> 返金を記録する_状態が違う
