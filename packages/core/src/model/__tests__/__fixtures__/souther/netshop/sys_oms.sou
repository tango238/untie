// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 販売管理システム
//
// 状態は data、操作は behavior。条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れと、条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_oms

// ---- 状態

data 注文の状態 = 受付済 | 確定 | 入金済 | 出荷済 | 取消

data 返品の状態 = 返品受付 | 検品済 | 返金済

// ---- 操作

// 操作: 注文を確定する
//   作業: 注文内容を確認する (担当: 受注担当)
//   取得する情報: 注文
//   保存する情報: 注文
//   起きる出来事: 注文が確定した
behavior 注文を確定する : (前の注文の状態: 受付済) -> 確定
let 注文を確定する (前の注文の状態) = 確定
example 注文を確定する
    | "ふだんの流れ: 受付済 から → 確定" : (受付済) -> 確定

// 操作: 注文を取り消す
//   作業: 注文内容を確認する (担当: 受注担当)
//   取得する情報: 注文
//   保存する情報: 注文
//   起きる出来事: 注文が取り消された
behavior 注文を取り消す : (前の注文の状態: 受付済) -> 取消
let 注文を取り消す (前の注文の状態) = 取消
example 注文を取り消す
    | "ふだんの流れ: 受付済 から → 取消" : (受付済) -> 取消

// 操作: 在庫を引き当てる
//   取得する情報: 在庫・注文
//   保存する情報: 在庫
//   起きる出来事: 在庫が引き当てられた
//   在庫が足りないとき: 引き当てずに、入荷を待つ注文として残す。
behavior 在庫を引き当てる : (前の注文の状態: 確定, 在庫が足りない: Bool) -> 在庫を引き当てる_完了 | 在庫を引き当てる_在庫が足りない
let 在庫を引き当てる (前の注文の状態, 在庫が足りない) = {
    guard Bool.not(在庫が足りない) else 在庫を引き当てる_在庫が足りない
    在庫を引き当てる_完了
}
example 在庫を引き当てる
    | "ふだんの流れ: 確定 から → 完了" : (確定, false) -> 在庫を引き当てる_完了
    | "在庫が足りないとき: 引き当てずに、入荷を待つ注文として残す。" : (確定, true) -> 在庫を引き当てる_在庫が足りない

// 操作: ピッキングリストを出す
//   作業: ピッキングする (担当: 倉庫担当)
//   取得する情報: 注文・商品
//   起きる出来事: ピッキングの指示が出た
//   ギフト包装の指定があるとき: ピッキングリストに、ギフト包装の指示を載せる。
behavior ピッキングリストを出す : (ギフト包装の指定がある: Bool) -> ピッキングリストを出す_完了 | ピッキングリストを出す_ギフト包装の指定がある
let ピッキングリストを出す (ギフト包装の指定がある) = {
    guard Bool.not(ギフト包装の指定がある) else ピッキングリストを出す_ギフト包装の指定がある
    ピッキングリストを出す_完了
}
example ピッキングリストを出す
    | "ふだんの流れ → 完了" : (false) -> ピッキングリストを出す_完了
    | "ギフト包装の指定があるとき: ピッキングリストに、ギフト包装の指示を載せる。" : (true) -> ピッキングリストを出す_ギフト包装の指定がある

// 操作: 送り状を発行する
//   作業: 送り状を発行して荷物を渡す (担当: 倉庫担当・配送業者)
//   取得する情報: 出荷・注文
//   保存する情報: 出荷
//   起きる出来事: 送り状が発行された
behavior 送り状を発行する : (前の注文の状態: 入金済) -> 送り状を発行する_完了
let 送り状を発行する (前の注文の状態) = 送り状を発行する_完了
example 送り状を発行する
    | "ふだんの流れ: 入金済 から → 完了" : (入金済) -> 送り状を発行する_完了

// 操作: 出荷を記録する
//   作業: 発送を連絡する (担当: 受注担当・購入者)
//   取得する情報: 出荷
//   保存する情報: 出荷
//   起きる出来事: 出荷が記録された
behavior 出荷を記録する : (前の注文の状態: 入金済) -> 出荷済
let 出荷を記録する (前の注文の状態) = 出荷済
example 出荷を記録する
    | "ふだんの流れ: 入金済 から → 出荷済" : (入金済) -> 出荷済

// 操作: 返品を登録する
//   作業: 返品を受け付ける (担当: カスタマーサポート・購入者)
//   取得する情報: 返品・注文
//   保存する情報: 返品
//   起きる出来事: 返品を受け付けた
//   返品の期間内である でないとき: 返品を受け付けず、理由を購入者に伝える。
behavior 返品を登録する : (前の注文の状態: 出荷済, 返品の期間内である: Bool) -> 返品受付 | 返品を登録する_返品の期間内である_でない
let 返品を登録する (前の注文の状態, 返品の期間内である) = {
    guard 返品の期間内である else 返品を登録する_返品の期間内である_でない
    返品受付
}
example 返品を登録する
    | "ふだんの流れ: 出荷済 から → 返品受付" : (出荷済, true) -> 返品受付
    | "返品の期間内である でないとき: 返品を受け付けず、理由を購入者に伝える。" : (出荷済, false) -> 返品を登録する_返品の期間内である_でない

// 操作: 返品の検品結果を記録する
//   作業: 返品を検品する (担当: 倉庫担当)
//   取得する情報: 返品
//   保存する情報: 返品
//   起きる出来事: 返品の検品が済んだ
behavior 返品の検品結果を記録する : (前の返品の状態: 返品受付) -> 検品済
let 返品の検品結果を記録する (前の返品の状態) = 検品済
example 返品の検品結果を記録する
    | "ふだんの流れ: 返品受付 から → 検品済" : (返品受付) -> 検品済

