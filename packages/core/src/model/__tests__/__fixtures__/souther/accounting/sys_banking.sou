module untie.sys_banking

// ---- 状態

data 支払の状態 = 受領済 | 承認済 | 支払済

// ---- 操作

// 操作: 振込データを作る
//   作業: 支払を実行する・精算金を支払う (担当: 支払担当・銀行・経費担当)
//   取得する情報: 支払・買掛金・経費の申請
//   保存する情報: 支払
behavior 振込データを作る : (前の支払の状態: 承認済) -> 支払済
let 振込データを作る (前の支払の状態) = 支払済
example 振込データを作る
    | "ふだんの流れ: 承認済 から → 支払済" : (承認済) -> 支払済

