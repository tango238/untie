//   保存する情報: 試算表
behavior 月次決算を確定する : (前の月次決算の状態: 試算表作成済) -> 確定
let 月次決算を確定する (前の月次決算の状態) = 確定
example 月次決算を確定する
    | "ふだんの流れ: 試算表作成済 から → 確定" : (試算表作成済) -> 確定

// 操作: 損益計算書を見る
//   作業: 損益を確認する (担当: 経理責任者・経営者)
//   取得する情報: 損益計算書 (PL)
behavior 損益計算書を見る : (前の月次決算の状態: 試算表作成済) -> 損益計算書を見る_完了
let 損益計算書を見る (前の月次決算の状態) = 損益計算書を見る_完了
example 損益計算書を見る
    | "ふだんの流れ: 試算表作成済 から → 完了" : (試算表作成済) -> 損益計算書を見る_完了

// 操作: 貸借対照表を見る
//   作業: 財務の状況を確認する (担当: 経理責任者・経営者)
//   取得する情報: 貸借対照表 (BS)
behavior 貸借対照表を見る : (前の月次決算の状態: 試算表作成済) -> 貸借対照表を見る_完了
let 貸借対照表を見る (前の月次決算の状態) = 貸借対照表を見る_完了
example 貸借対照表を見る
    | "ふだんの流れ: 試算表作成済 から → 完了" : (試算表作成済) -> 貸借対照表を見る_完了

