// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 会計システム
//
// 状態は data (グループごとに、どれか 1 つの値)、操作は behavior。操作は今の状態を受け取り、前提の状態でなければ「状態が違う」を返す。
// 条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れ・前提の状態が違うとき・条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_accounting

// ---- 状態

data 売掛金の状態 = 未入金 | 一部入金 | 消込済

data 支払の状態 = 受領済 | 承認済 | 支払済

data 月次決算の状態 = 調整中 | 試算表作成済 | 確定

// ---- 操作

// 操作: 売掛金を消し込む
//   作業: 入金を消し込む (担当: 請求担当)
//   取得する情報: 売掛金・入金
//   保存する情報: 売掛金
//   入金額が請求額と違うとき: 差額の理由 (振込手数料・まとめ払い) を確かめ、差額を別に記録してから消し込む。 [そのあとの状態: ふだんと同じ]
behavior 売掛金を消し込む : (今の売掛金の状態: 売掛金の状態, 入金額が請求額と違う: Bool) -> 一部入金 | 消込済 | 売掛金を消し込む_入金額が請求額と違う | 売掛金を消し込む_状態が違う
// 次の状態が決まっていないので、中身はまだ書けない (行は、何が要るかを記録するだけ)
example 売掛金を消し込む
    | "ふだんの流れ: 未入金 から → 一部入金 か 消込済" : (未入金, false) -> <?>
    | "ふだんの流れ: 一部入金 から → 一部入金 か 消込済" : (一部入金, false) -> <?>
    | "前提の状態が違う: 消込済 では行えない" : (消込済, false) -> 売掛金を消し込む_状態が違う
    | "入金額が請求額と違うとき: 差額の理由 (振込手数料・まとめ払い) を確かめ、差額を別に記録してから消し込む。" : (未入金, true) -> 売掛金を消し込む_入金額が請求額と違う

// 操作: 支払を承認する
//   作業: 支払を承認する (担当: 経理責任者・経営者)
//   取得する情報: 買掛金
//   保存する情報: 買掛金
//   支払が承認の上限を超えているとき: 経営者の承認をもらってから、支払を承認する。 [そのあとの状態: ふだんと同じ]
data 支払を承認する_支払が承認の上限を超えている = { 支払の状態: 支払の状態 }
behavior 支払を承認する : (今の支払の状態: 支払の状態, 支払が承認の上限を超えている: Bool) -> 承認済 | 支払を承認する_支払が承認の上限を超えている | 支払を承認する_状態が違う
let 支払を承認する (今の支払の状態, 支払が承認の上限を超えている) = {
    guard 今の支払の状態 == 受領済 else 支払を承認する_状態が違う
    guard Bool.not(支払が承認の上限を超えている) else 支払を承認する_支払が承認の上限を超えている { 支払の状態 = 承認済 }
    承認済
}
example 支払を承認する
    | "ふだんの流れ: 受領済 から → 承認済" : (受領済, false) -> 承認済
    | "前提の状態が違う: 承認済 では行えない" : (承認済, false) -> 支払を承認する_状態が違う
    | "前提の状態が違う: 支払済 では行えない" : (支払済, false) -> 支払を承認する_状態が違う
    | "支払が承認の上限を超えているとき: 経営者の承認をもらってから、支払を承認する。" : (受領済, true) -> 支払を承認する_支払が承認の上限を超えている { 支払の状態 = 承認済 }

// 操作: 調整仕訳を登録する
//   作業: 月末の調整仕訳を入れる・決算整理をする (担当: 経理責任者)
//   取得する情報: 仕訳
//   保存する情報: 仕訳
behavior 調整仕訳を登録する : (今の月次決算の状態: 月次決算の状態) -> 調整中 | 調整仕訳を登録する_状態が違う
let 調整仕訳を登録する (今の月次決算の状態) = {
    guard 今の月次決算の状態 == 調整中 else 調整仕訳を登録する_状態が違う
    調整中
}
example 調整仕訳を登録する
    | "ふだんの流れ: 調整中 から → 調整中" : (調整中) -> 調整中
    | "前提の状態が違う: 試算表作成済 では行えない" : (試算表作成済) -> 調整仕訳を登録する_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 調整仕訳を登録する_状態が違う

// 操作: 試算表を出力する
//   作業: 試算表を作る (担当: 経理責任者)
//   取得する情報: 試算表・仕訳
//   保存する情報: 試算表
behavior 試算表を出力する : (今の月次決算の状態: 月次決算の状態) -> 試算表作成済 | 試算表を出力する_状態が違う
let 試算表を出力する (今の月次決算の状態) = {
    guard 今の月次決算の状態 == 調整中 else 試算表を出力する_状態が違う
    試算表作成済
}
example 試算表を出力する
    | "ふだんの流れ: 調整中 から → 試算表作成済" : (調整中) -> 試算表作成済
    | "前提の状態が違う: 試算表作成済 では行えない" : (試算表作成済) -> 試算表を出力する_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 試算表を出力する_状態が違う

// 操作: 月次決算を確定する
//   作業: 試算表を作る (担当: 経理責任者)
//   取得する情報: 試算表
//   保存する情報: 試算表
behavior 月次決算を確定する : (今の月次決算の状態: 月次決算の状態) -> 確定 | 月次決算を確定する_状態が違う
let 月次決算を確定する (今の月次決算の状態) = {
    guard 今の月次決算の状態 == 試算表作成済 else 月次決算を確定する_状態が違う
    確定
}
example 月次決算を確定する
    | "ふだんの流れ: 試算表作成済 から → 確定" : (試算表作成済) -> 確定
    | "前提の状態が違う: 調整中 では行えない" : (調整中) -> 月次決算を確定する_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 月次決算を確定する_状態が違う

// 操作: 損益計算書を見る
//   作業: 損益を確認する (担当: 経理責任者・経営者)
//   取得する情報: 損益計算書 (PL)
behavior 損益計算書を見る : (今の月次決算の状態: 月次決算の状態) -> 損益計算書を見る_完了 | 損益計算書を見る_状態が違う
let 損益計算書を見る (今の月次決算の状態) = {
    guard 今の月次決算の状態 == 試算表作成済 else 損益計算書を見る_状態が違う
    損益計算書を見る_完了
}
example 損益計算書を見る
    | "ふだんの流れ: 試算表作成済 から → 完了" : (試算表作成済) -> 損益計算書を見る_完了
    | "前提の状態が違う: 調整中 では行えない" : (調整中) -> 損益計算書を見る_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 損益計算書を見る_状態が違う

// 操作: 貸借対照表を見る
//   作業: 財務の状況を確認する (担当: 経理責任者・経営者)
//   取得する情報: 貸借対照表 (BS)
behavior 貸借対照表を見る : (今の月次決算の状態: 月次決算の状態) -> 貸借対照表を見る_完了 | 貸借対照表を見る_状態が違う
let 貸借対照表を見る (今の月次決算の状態) = {
    guard 今の月次決算の状態 == 試算表作成済 else 貸借対照表を見る_状態が違う
    貸借対照表を見る_完了
}
example 貸借対照表を見る
    | "ふだんの流れ: 試算表作成済 から → 完了" : (試算表作成済) -> 貸借対照表を見る_完了
    | "前提の状態が違う: 調整中 では行えない" : (調整中) -> 貸借対照表を見る_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 貸借対照表を見る_状態が違う

