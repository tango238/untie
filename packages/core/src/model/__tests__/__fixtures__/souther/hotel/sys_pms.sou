// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 宿泊管理システム
//
// 状態は data、操作は behavior。条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れと、条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_pms

// ---- 状態

data 予約の状態 = 仮予約 | 確定 | チェックイン済 | チェックアウト済 | 取消

data 部屋の状態 = 清掃待ち | 清掃中 | 準備完了 | 使用中

// ---- 操作

// 操作: 予約を確定する
//   作業: 予約内容を確認する (担当: 予約担当)
//   取得する情報: 予約
//   保存する情報: 予約
behavior 予約を確定する : (前の予約の状態: 仮予約) -> 確定
let 予約を確定する (前の予約の状態) = 確定
example 予約を確定する
    | "ふだんの流れ: 仮予約 から → 確定" : (仮予約) -> 確定

// 操作: 予約を変更する
//   作業: 予約を変更・取消する (担当: 予約担当・宿泊客)
//   取得する情報: 予約
//   保存する情報: 予約
behavior 予約を変更する : (前の予約の状態: 確定) -> 確定
let 予約を変更する (前の予約の状態) = 確定
example 予約を変更する
    | "ふだんの流れ: 確定 から → 確定" : (確定) -> 確定

// 操作: 予約を取り消す
//   作業: 予約を変更・取消する (担当: 予約担当・宿泊客)
//   取得する情報: 予約
//   保存する情報: 予約
//   取消料が発生するとき: 取消料を請求に加えてから、予約を取り消す。
behavior 予約を取り消す : (前の予約の状態: 確定, 取消料が発生する: Bool) -> 取消 | 予約を取り消す_取消料が発生する
let 予約を取り消す (前の予約の状態, 取消料が発生する) = {
    guard Bool.not(取消料が発生する) else 予約を取り消す_取消料が発生する
    取消
}
example 予約を取り消す
    | "ふだんの流れ: 確定 から → 取消" : (確定, false) -> 取消
    | "取消料が発生するとき: 取消料を請求に加えてから、予約を取り消す。" : (確定, true) -> 予約を取り消す_取消料が発生する

// 操作: チェックインを記録する
//   作業: 本人確認をする (担当: フロント担当・宿泊客)
//   取得する情報: 予約・宿泊客
//   保存する情報: 予約・宿泊客
//   早めのチェックインができる でないとき: 部屋の準備が済むまで、ロビーで待ってもらう。
behavior チェックインを記録する : (前の予約の状態: 確定, 早めのチェックインができる: Bool) -> チェックイン済 | チェックインを記録する_早めのチェックインができる_でない
let チェックインを記録する (前の予約の状態, 早めのチェックインができる) = {
    guard 早めのチェックインができる else チェックインを記録する_早めのチェックインができる_でない
    チェックイン済
}
example チェックインを記録する
    | "ふだんの流れ: 確定 から → チェックイン済" : (確定, true) -> チェックイン済
    | "早めのチェックインができる でないとき: 部屋の準備が済むまで、ロビーで待ってもらう。" : (確定, false) -> チェックインを記録する_早めのチェックインができる_でない

// 操作: 部屋の割り当てを記録する
//   作業: 部屋を割り当てる (担当: フロント担当)
//   取得する情報: 部屋・予約
//   保存する情報: 部屋
//   満室であるとき: 部屋を割り当てず、空きが出るまで待ってもらう。
behavior 部屋の割り当てを記録する : (前の部屋の状態: 準備完了, 満室である: Bool) -> 使用中 | 部屋の割り当てを記録する_満室である
let 部屋の割り当てを記録する (前の部屋の状態, 満室である) = {
    guard Bool.not(満室である) else 部屋の割り当てを記録する_満室である
    使用中
}
example 部屋の割り当てを記録する
    | "ふだんの流れ: 準備完了 から → 使用中" : (準備完了, false) -> 使用中
    | "満室であるとき: 部屋を割り当てず、空きが出るまで待ってもらう。" : (準備完了, true) -> 部屋の割り当てを記録する_満室である

// 操作: 追加料金を登録する
//   作業: 追加料金を記録する (担当: フロント担当)
//   取得する情報: 請求
//   保存する情報: 請求
behavior 追加料金を登録する : (前の予約の状態: チェックイン済) -> 追加料金を登録する_完了
let 追加料金を登録する (前の予約の状態) = 追加料金を登録する_完了
example 追加料金を登録する
    | "ふだんの流れ: チェックイン済 から → 完了" : (チェックイン済) -> 追加料金を登録する_完了

// 操作: チェックアウトを記録する
//   作業: 鍵を回収する (担当: フロント担当)
//   取得する情報: 予約・部屋
//   保存する情報: 予約・部屋
data チェックアウトを記録する_結果 = { 予約の状態: チェックアウト済, 部屋の状態: 清掃待ち }
behavior チェックアウトを記録する : (前の予約の状態: チェックイン済) -> チェックアウトを記録する_結果
let チェックアウトを記録する (前の予約の状態) = チェックアウトを記録する_結果 { 予約の状態 = チェックアウト済, 部屋の状態 = 清掃待ち }
example チェックアウトを記録する
    | "ふだんの流れ: チェックイン済 から → チェックアウト済・清掃待ち" : (チェックイン済) -> チェックアウトを記録する_結果

