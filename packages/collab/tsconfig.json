{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM にも React にも依存しない (サーバーの Durable Object からも使う)。型検査で守る
    "lib": ["ES2022"],
    // Node のグローバル (process・Buffer など) を使っていないことも型検査で守る
    "types": []
  },
  "include": ["src"],
  // Worker の API を使う room は、types が違うので src/room/tsconfig.json で検査する
  "exclude": ["src/room"]
}
