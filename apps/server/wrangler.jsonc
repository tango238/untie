{
  // クラウド版: 1 つの Worker がクラウド版の画面 (apps/cloud) の静的ファイル・API・Durable Object (UntieRoom) を持つ (docs/collab-design.md 7 章・9 章)
  //
  // 【本番に上げる前に置き換える値】(手順は README の「クラウド版の配信 (Cloudflare Workers)」)
  //   1. d1_databases[0].database_id  … `wrangler d1 create untie --location apac` で出た id
  //   2. vars.APP_ORIGIN              … 公開の URL (例: https://untie.example.com)
  // それ以外の秘密の値 (SESSION_SECRET・TICKET_SECRET・GOOGLE_CLIENT_ID・GOOGLE_CLIENT_SECRET) は、ここには書かず `wrangler secret put` で入れる。
  // `<本番で置き換える>` のままでも `wrangler deploy --dry-run` (pnpm build / CI) は通るが、`wrangler deploy` は D1 を見つけられず失敗する
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "untie-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],

  // apps/cloud のビルド結果 (SPA)。存在しないパスは index.html を返す
  "assets": {
    "directory": "../cloud/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // ブラウザの画面遷移 (Sec-Fetch-Mode: navigate) は、SPA の設定だと存在しないパスが index.html になってしまう。
    // これらのパスは必ず先に Worker が受ける (ログイン画面・コールバック・書き出しのダウンロード・WebSocket)。
    // "/" と "/index.html" は、APP_ORIGIN 以外のホスト (workers.dev など) で開かれたとき、Worker が APP_ORIGIN へ 302 で移すため
    "run_worker_first": ["/auth/*", "/api/*", "/parties/*", "/", "/index.html"]
  },

  // 【公開のホスト】既定は workers.dev (`untie-cloud.<アカウント>.workers.dev`)。独自ドメインで配るときは、次の 2 行を有効にする
  // (ゾーンが同じ Cloudflare アカウントにあること。`custom_domain: true` で deploy 時に DNS レコードと証明書が自動で作られる):
  //   "workers_dev": false,
  //   "routes": [{ "pattern": "untie.example.com", "custom_domain": true }],
  // workers.dev も残す (`"workers_dev": true` のまま) ときは、vars.APP_ORIGIN を独自ドメインにしておく。
  // workers.dev で開かれた画面・ログインは APP_ORIGIN の同じパスへ 302 で移るので、どちらで開いてもログインは 1 つのホストで済む
  // (/parties・/api/links/*・/auth/desktop/exchange と、デスクトップアプリからの呼び出しは移さない)。
  // Google の OAuth クライアントの redirect URI には `https://<独自ドメイン>/auth/callback` を登録する。
  // "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "untie",
      // 【本番で置き換える】`wrangler d1 create untie --location apac` で出た database_id。
      // ローカル (pnpm dev・pnpm test) では使われないので、この値のままでよい
      "database_id": "<本番で置き換える>",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "UntieRoom", "class_name": "UntieRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UntieRoom"] }],

  // ゴミ箱の掃除 (毎日 03:00 UTC)
  "triggers": { "crons": ["0 3 * * *"] },

  // 秘密の値 (SESSION_SECRET・TICKET_SECRET・GOOGLE_CLIENT_ID・GOOGLE_CLIENT_SECRET) は `wrangler secret put` で入れる。
  // 開発用の値は .dev.vars にある
  "vars": {
    // ログインを許すメールのドメイン (カンマ区切り)。空なら制限なし
    "ALLOWED_EMAIL_DOMAINS": "",
    // 開発用ログイン (メールを打つだけ)。本番は "false" のまま
    "DEV_LOGIN": "false",
    // 【本番で置き換える】公開の URL (例: https://untie.example.com)。Google の redirect URI (`<APP_ORIGIN>/auth/callback`) と、
    // 招待・リンクの URL の組み立てに使う。空なら受けたリクエストのオリジン。Cookie の Secure は APP_ORIGIN ではなくリクエストが https かどうかで付く。
    // 開発 (.dev.vars) は http://localhost:5173 に上書きする
    "APP_ORIGIN": ""
  },

  "observability": { "enabled": true }
}
