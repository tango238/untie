// untie が分析から書き出した、業務ルールの骨組み (自動生成。手で直しても、書き出し直すと消える)
// システム: 宿泊管理システム
//
// 状態は data (グループごとに、どれか 1 つの値)、操作は behavior。操作は今の状態を受け取り、前提の状態でなければ「状態が違う」を返す。
// 条件は真偽の入力にしてある (何で判断するかの式は、分析に無いのでまだ書いていない)。
// example の行は、ふだんの流れ・前提の状態が違うとき・条件のときの流れ (代替パターン)。答えが `<?>` の行は、まだ決まっていない組み合わせ。
module untie.sys_pms

// ---- 状態

data 予約の状態 = 仮予約 | 確定 | チェックイン済 | チェックアウト済 | 取消

data 部屋の状態 = 清掃待ち | 清掃中 | 準備完了 | 使用中

// ---- 操作

// 操作: 予約を確定する
//   作業: 予約内容を確認する (担当: 予約担当)
//   取得する情報: 予約
//   保存する情報: 予約
behavior 予約を確定する : (今の予約の状態: 予約の状態) -> 確定 | 予約を確定する_状態が違う
let 予約を確定する (今の予約の状態) = {
    guard 今の予約の状態 == 仮予約 else 予約を確定する_状態が違う
    確定
}
example 予約を確定する
    | "ふだんの流れ: 仮予約 から → 確定" : (仮予約) -> 確定
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 予約を確定する_状態が違う
    | "前提の状態が違う: チェックイン済 では行えない" : (チェックイン済) -> 予約を確定する_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済) -> 予約を確定する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消) -> 予約を確定する_状態が違う

// 操作: 予約を変更する
//   作業: 予約を変更・取消する (担当: 予約担当・宿泊客)
//   取得する情報: 予約
//   保存する情報: 予約
behavior 予約を変更する : (今の予約の状態: 予約の状態) -> 確定 | 予約を変更する_状態が違う
let 予約を変更する (今の予約の状態) = {
    guard 今の予約の状態 == 確定 else 予約を変更する_状態が違う
    確定
}
example 予約を変更する
    | "ふだんの流れ: 確定 から → 確定" : (確定) -> 確定
    | "前提の状態が違う: 仮予約 では行えない" : (仮予約) -> 予約を変更する_状態が違う
    | "前提の状態が違う: チェックイン済 では行えない" : (チェックイン済) -> 予約を変更する_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済) -> 予約を変更する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消) -> 予約を変更する_状態が違う

// 操作: 予約を取り消す
//   作業: 予約を変更・取消する (担当: 予約担当・宿泊客)
//   取得する情報: 予約
//   保存する情報: 予約
//   取消料が発生するとき: 取消料を請求に加えてから、予約を取り消す。 [そのあとの状態: ふだんと同じ]
data 予約を取り消す_取消料が発生する = { 予約の状態: 予約の状態 }
behavior 予約を取り消す : (今の予約の状態: 予約の状態, 取消料が発生する: Bool) -> 取消 | 予約を取り消す_取消料が発生する | 予約を取り消す_状態が違う
let 予約を取り消す (今の予約の状態, 取消料が発生する) = {
    guard 今の予約の状態 == 確定 else 予約を取り消す_状態が違う
    guard Bool.not(取消料が発生する) else 予約を取り消す_取消料が発生する { 予約の状態 = 取消 }
    取消
}
example 予約を取り消す
    | "ふだんの流れ: 確定 から → 取消" : (確定, false) -> 取消
    | "前提の状態が違う: 仮予約 では行えない" : (仮予約, false) -> 予約を取り消す_状態が違う
    | "前提の状態が違う: チェックイン済 では行えない" : (チェックイン済, false) -> 予約を取り消す_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済, false) -> 予約を取り消す_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消, false) -> 予約を取り消す_状態が違う
    | "取消料が発生するとき: 取消料を請求に加えてから、予約を取り消す。" : (確定, true) -> 予約を取り消す_取消料が発生する { 予約の状態 = 取消 }

// 操作: チェックインを記録する
//   作業: 本人確認をする (担当: フロント担当・宿泊客)
//   取得する情報: 予約・宿泊客
//   保存する情報: 予約・宿泊客
//   早めのチェックインができる でないとき: 部屋の準備が済むまで、ロビーで待ってもらう。 [そのあとの状態: 変えない]
behavior チェックインを記録する : (今の予約の状態: 予約の状態, 早めのチェックインができる: Bool) -> チェックイン済 | チェックインを記録する_早めのチェックインができる_でない | チェックインを記録する_状態が違う
let チェックインを記録する (今の予約の状態, 早めのチェックインができる) = {
    guard 今の予約の状態 == 確定 else チェックインを記録する_状態が違う
    guard 早めのチェックインができる else チェックインを記録する_早めのチェックインができる_でない
    チェックイン済
}
example チェックインを記録する
    | "ふだんの流れ: 確定 から → チェックイン済" : (確定, true) -> チェックイン済
    | "前提の状態が違う: 仮予約 では行えない" : (仮予約, true) -> チェックインを記録する_状態が違う
    | "前提の状態が違う: チェックイン済 では行えない" : (チェックイン済, true) -> チェックインを記録する_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済, true) -> チェックインを記録する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消, true) -> チェックインを記録する_状態が違う
    | "早めのチェックインができる でないとき: 部屋の準備が済むまで、ロビーで待ってもらう。" : (確定, false) -> チェックインを記録する_早めのチェックインができる_でない

// 操作: 部屋の割り当てを記録する
//   作業: 部屋を割り当てる (担当: フロント担当)
//   取得する情報: 部屋・予約
//   保存する情報: 部屋
//   満室であるとき: 部屋を割り当てず、空きが出るまで待ってもらう。 [そのあとの状態: 変えない]
behavior 部屋の割り当てを記録する : (今の部屋の状態: 部屋の状態, 満室である: Bool) -> 使用中 | 部屋の割り当てを記録する_満室である | 部屋の割り当てを記録する_状態が違う
let 部屋の割り当てを記録する (今の部屋の状態, 満室である) = {
    guard 今の部屋の状態 == 準備完了 else 部屋の割り当てを記録する_状態が違う
    guard Bool.not(満室である) else 部屋の割り当てを記録する_満室である
    使用中
}
example 部屋の割り当てを記録する
    | "ふだんの流れ: 準備完了 から → 使用中" : (準備完了, false) -> 使用中
    | "前提の状態が違う: 清掃待ち では行えない" : (清掃待ち, false) -> 部屋の割り当てを記録する_状態が違う
    | "前提の状態が違う: 清掃中 では行えない" : (清掃中, false) -> 部屋の割り当てを記録する_状態が違う
    | "前提の状態が違う: 使用中 では行えない" : (使用中, false) -> 部屋の割り当てを記録する_状態が違う
    | "満室であるとき: 部屋を割り当てず、空きが出るまで待ってもらう。" : (準備完了, true) -> 部屋の割り当てを記録する_満室である

// 操作: 追加料金を登録する
//   作業: 追加料金を記録する (担当: フロント担当)
//   取得する情報: 請求
//   保存する情報: 請求
behavior 追加料金を登録する : (今の予約の状態: 予約の状態) -> 追加料金を登録する_完了 | 追加料金を登録する_状態が違う
let 追加料金を登録する (今の予約の状態) = {
    guard 今の予約の状態 == チェックイン済 else 追加料金を登録する_状態が違う
    追加料金を登録する_完了
}
example 追加料金を登録する
    | "ふだんの流れ: チェックイン済 から → 完了" : (チェックイン済) -> 追加料金を登録する_完了
    | "前提の状態が違う: 仮予約 では行えない" : (仮予約) -> 追加料金を登録する_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> 追加料金を登録する_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済) -> 追加料金を登録する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消) -> 追加料金を登録する_状態が違う

// 操作: チェックアウトを記録する
//   作業: 鍵を回収する (担当: フロント担当)
//   取得する情報: 予約・部屋
//   保存する情報: 予約・部屋
data チェックアウトを記録する_結果 = { 予約の状態: 予約の状態, 部屋の状態: 部屋の状態 }
behavior チェックアウトを記録する : (今の予約の状態: 予約の状態) -> チェックアウトを記録する_結果 | チェックアウトを記録する_状態が違う
let チェックアウトを記録する (今の予約の状態) = {
    guard 今の予約の状態 == チェックイン済 else チェックアウトを記録する_状態が違う
    チェックアウトを記録する_結果 { 予約の状態 = チェックアウト済, 部屋の状態 = 清掃待ち }
}
example チェックアウトを記録する
    | "ふだんの流れ: チェックイン済 から → チェックアウト済・清掃待ち" : (チェックイン済) -> チェックアウトを記録する_結果 { 予約の状態 = チェックアウト済, 部屋の状態 = 清掃待ち }
    | "前提の状態が違う: 仮予約 では行えない" : (仮予約) -> チェックアウトを記録する_状態が違う
    | "前提の状態が違う: 確定 では行えない" : (確定) -> チェックアウトを記録する_状態が違う
    | "前提の状態が違う: チェックアウト済 では行えない" : (チェックアウト済) -> チェックアウトを記録する_状態が違う
    | "前提の状態が違う: 取消 では行えない" : (取消) -> チェックアウトを記録する_状態が違う

// ---- 書き出していない操作 (前提の状態も、判断する条件も無いので、確かめる組み合わせが無い)
//   予約を検索する
//   請求金額を計算する
