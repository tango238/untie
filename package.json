{
  "name": "untie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app:build": "APPLE_SIGNING_IDENTITY=\"Untie Local Code Signing\" tauri build",
    "web:deploy": "pnpm build && pnpm dlx wrangler@4 pages deploy dist --project-name untie --branch main",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "gen:types": "json2ts -i schema/untie.schema.json -o src/model/schema.d.ts && node scripts/gen-validator.mjs",
    "check:types": "pnpm gen:types && git diff --exit-code src/model/schema.d.ts src/model/schemaValidator.gen.js",
    "gen:validator": "node scripts/gen-validator.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "immer": "^11.2.7",
    "openai": "^7.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
