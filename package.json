{
  "name": "untie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @untie/web --filter @untie/server dev",
    "build": "pnpm --filter @untie/web build && pnpm --filter @untie/desktop build && pnpm --filter @untie/server check",
    "tauri": "pnpm --filter @untie/desktop tauri",
    "app:build": "pnpm --filter @untie/desktop app:build",
    "icon": "pnpm --filter @untie/desktop tauri icon ../../assets/icon.png",
    "deploy": "pnpm --filter @untie/server run deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "gen:types": "pnpm --filter @untie/core gen:types",
    "check:types": "pnpm gen:types && git diff --exit-code packages/core/src/model/schema.d.ts packages/core/src/model/schemaValidator.gen.js",
    "gen:validator": "pnpm --filter @untie/core gen:validator"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
